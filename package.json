{
  "name": "ldb-safehub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:web": "vite build",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:single": "vite build --config vite.single.config.ts && node scripts/finalize-single-file.mjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js server.ts",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:worker": "vitest run worker/index.test.ts",
    "cf:types": "wrangler types worker/bindings.d.ts",
    "cf:config": "node scripts/write-wrangler-config.mjs",
    "cf:migrate:prod": "wrangler d1 migrations apply ldb-safehub-prod --remote",
    "deploy:prod": "npm run build:web && wrangler deploy",
    "deploy:uat": "npm run build:web && wrangler deploy --env uat"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
